# Copiá este archivo como .env y completá los valores.
# Supabase → Project Settings → API (o "Connect")
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# WhatsApp del negocio en formato internacional, sin "+", sin 0 ni 15.
# 3884 13-1570 → 5493884131570
VITE_WHATSAPP_NUMBER=5493884131570

# Opcional: perfil de Instagram del negocio
VITE_INSTAGRAM_URL=https://www.instagram.com/laspalmeras.club

# Cloudinary (fotos de las comidas, se guardan en WebP)
# Cloudinary → Settings → API Keys. Van SIN "VITE_": son secretas y solo las
# usa la función /api/cloudinary del servidor, nunca llegan al navegador.
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=tu-api-secret
# Opcional: carpeta donde se guardan las fotos
# CLOUDINARY_FOLDER=palmeras-club/comidas
